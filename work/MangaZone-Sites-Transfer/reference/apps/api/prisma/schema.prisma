model AdministrativeAuditEvent {
  id           String                        @id @default(uuid(7)) @db.Uuid
  actorUserId  String                        @db.Uuid
  targetUserId String                        @db.Uuid
  actionType   AdministrativeAuditActionType
  reason       String
  metadata     Json                          @db.JsonB
  createdAt    DateTime                      @default(now()) @db.Timestamptz(3)

  actor  User @relation("AdministrativeAuditEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target User @relation("AdministrativeAuditEventTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt, id])
  @@index([targetUserId, createdAt, id])
  @@index([actionType, createdAt, id])
}

model UserSanction {
  id              String           @id @default(uuid(7)) @db.Uuid
  userId          String           @db.Uuid
  type            UserSanctionType
  reason          String
  issuedByUserId  String?          @db.Uuid
  startsAt        DateTime         @default(now()) @db.Timestamptz(3)
  endsAt          DateTime?        @db.Timestamptz(3)
  revokedAt       DateTime?        @db.Timestamptz(3)
  revokedByUserId String?          @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  user          User           @relation("UserSanctionSubject", fields: [userId], references: [id], onDelete: Restrict)
  issuedBy      User?          @relation("UserSanctionIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  revokedBy     User?          @relation("UserSanctionRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  appeals       Appeal[]
  notifications Notification[]

  @@unique([userId, id])
  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([userId, revokedAt, endsAt])
  @@index([issuedByUserId])
  @@index([revokedByUserId])
}

model Appeal {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @db.Uuid
  userSanctionId String       @db.Uuid
  reason         String
  status         AppealStatus @default(PENDING)
  reviewerUserId String?      @db.Uuid
  decisionReason String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  reviewedAt     DateTime?    @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  user         User         @relation("AppealUser", fields: [userId], references: [id], onDelete: Restrict)
  userSanction UserSanction @relation(fields: [userId, userSanctionId], references: [userId, id], onDelete: Restrict)
  reviewer     User?        @relation("AppealReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userSanctionId, createdAt])
  @@index([status, createdAt])
  @@index([reviewerUserId])
}

model AccountDeletionRequest {
  id           String                       @id @default(uuid(7)) @db.Uuid
  userId       String                       @db.Uuid
  status       AccountDeletionRequestStatus @default(PENDING)
  requestedAt  DateTime                     @default(now()) @db.Timestamptz(3)
  scheduledFor DateTime                     @db.Timestamptz(3)
  cancelledAt  DateTime?                    @db.Timestamptz(3)
  processedAt  DateTime?                    @db.Timestamptz(3)
  createdAt    DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, scheduledFor])
}

model ContentDeletionRequest {
  id              String                       @id @default(uuid(7)) @db.Uuid
  requesterUserId String                       @db.Uuid
  reason          String
  details         String?
  status          ContentDeletionRequestStatus @default(PENDING)
  postId          String?                      @db.Uuid
  postCommentId   String?                      @db.Uuid
  reviewId        String?                      @db.Uuid
  reviewerUserId  String?                      @db.Uuid
  decisionReason  String?
  createdAt       DateTime                     @default(now()) @db.Timestamptz(3)
  reviewedAt      DateTime?                    @db.Timestamptz(3)
  updatedAt       DateTime                     @updatedAt @db.Timestamptz(3)

  requester   User         @relation("ContentDeletionRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  reviewer    User?        @relation("ContentDeletionReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  post        Post?        @relation(fields: [postId], references: [id], onDelete: Restrict)
  postComment PostComment? @relation(fields: [postCommentId], references: [id], onDelete: Restrict)
  review      Review?      @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@index([requesterUserId, createdAt])
  @@index([status, createdAt])
  @@index([reviewerUserId])
  @@index([postId])
  @@index([postCommentId])
  @@index([reviewId])
}

model Notification {
  id                  String               @id @default(uuid(7)) @db.Uuid
  userId              String               @db.Uuid
  actorUserId         String?              @db.Uuid
  type                String               @db.VarChar(120)
  category            NotificationCategory
  payloadVersion      Int                  @default(1) @db.SmallInt
  payload             Json?                @db.JsonB
  mangaId             String?              @db.Uuid
  postId              String?              @db.Uuid
  postCommentId       String?              @db.Uuid
  reviewId            String?              @db.Uuid
  communityId         String?              @db.Uuid
  scanlationGroupId   String?              @db.Uuid
  scanlationProjectId String?              @db.Uuid
  chapterReleaseId    String?              @db.Uuid
  reportId            String?              @db.Uuid
  userSanctionId      String?              @db.Uuid
  readAt              DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)

  user              User               @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor             User?              @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  manga             Manga?             @relation(fields: [mangaId], references: [id], onDelete: SetNull)
  post              Post?              @relation(fields: [postId], references: [id], onDelete: SetNull)
  postComment       PostComment?       @relation(fields: [postCommentId], references: [id], onDelete: SetNull)
  review            Review?            @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  community         Community?         @relation(fields: [communityId], references: [id], onDelete: SetNull)
  scanlationGroup   ScanlationGroup?   @relation(fields: [scanlationGroupId], references: [id], onDelete: SetNull)
  scanlationProject ScanlationProject? @relation(fields: [scanlationProjectId], references: [id], onDelete: SetNull)
  chapterRelease    ChapterRelease?    @relation(fields: [chapterReleaseId], references: [id], onDelete: SetNull)
  report            Report?            @relation(fields: [reportId], references: [id], onDelete: SetNull)
  userSanction      UserSanction?      @relation(fields: [userSanctionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([userId, category, createdAt])
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  rolePermissions RolePermission[]
  userGrants      UserPermissionGrant[]
}

model UserRole {
  userId           String   @db.Uuid
  roleId           String   @db.Uuid
  assignedAt       DateTime @default(now()) @db.Timestamptz(3)
  assignedByUserId String?  @db.Uuid

  user       User  @relation("UserRoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserPermissionGrant {
  userId          String   @db.Uuid
  permissionId    String   @db.Uuid
  grantedAt       DateTime @default(now()) @db.Timestamptz(3)
  grantedByUserId String?  @db.Uuid

  user       User       @relation("UserPermissionGrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  grantedBy  User?      @relation("UserPermissionGrantGranter", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@index([grantedByUserId])
}

model Conversation {
  id              String           @id @default(uuid(7)) @db.Uuid
  type            ConversationType
  createdByUserId String?          @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  createdBy                  User?                       @relation("ConversationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  members                    ConversationMember[]
  messages                   Message[]
  directConversationIdentity DirectConversationIdentity?

  @@index([type])
  @@index([createdAt])
  @@index([createdByUserId])
}

model ConversationMember {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  joinedAt       DateTime  @default(now()) @db.Timestamptz(3)
  leftAt         DateTime? @db.Timestamptz(3)
  mutedUntil     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@index([userId])
}

model DirectConversationIdentity {
  conversationId String   @unique @db.Uuid
  userLowId      String   @db.Uuid
  userHighId     String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userLow      User         @relation("DirectConversationUserLow", fields: [userLowId], references: [id], onDelete: Restrict)
  userHigh     User         @relation("DirectConversationUserHigh", fields: [userHighId], references: [id], onDelete: Restrict)

  @@unique([userLowId, userHighId])
}

model Message {
  id               String    @id @default(uuid(7)) @db.Uuid
  conversationId   String    @db.Uuid
  senderUserId     String    @db.Uuid
  replyToMessageId String?   @db.Uuid
  body             String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  editedAt         DateTime? @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  replyToMessage Message?            @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        Message[]           @relation("MessageReplies")
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@index([replyToMessageId])
}

model MessageAttachment {
  id        String   @id @default(uuid(7)) @db.Uuid
  messageId String   @db.Uuid
  assetId   String   @db.Uuid
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([messageId, position])
  @@index([assetId])
}

// ──────────────────────────────────────────────
// Migration 014 — Auth Infrastructure
// ──────────────────────────────────────────────

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  tokenHash        String    @unique @db.VarChar(64)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  userAgentSummary String?   @db.VarChar(256)
  ipAddress        String?   @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.VarChar(64)
  expiresAt     DateTime  @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  invalidatedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.VarChar(64)
  expiresAt     DateTime  @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  invalidatedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestJob PasswordResetRequestJob?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetRequestJob {
  id                       String                        @id @default(uuid(7)) @db.Uuid
  requestedEmail           String?                       @db.VarChar(254)
  ipAddress                String?                       @db.VarChar(45)
  userAgentSummary         String?                       @db.VarChar(256)
  status                   PasswordResetRequestJobStatus @default(PENDING)
  attempts                 Int                           @default(0) @db.SmallInt
  availableAt              DateTime                      @default(now()) @db.Timestamptz(3)
  lockedAt                 DateTime?                     @db.Timestamptz(3)
  lockExpiresAt            DateTime?                     @db.Timestamptz(3)
  lockToken                String?                       @db.Uuid
  passwordResetTokenId     String?                       @unique @db.Uuid
  deliveryTokenCiphertext  String?
  deliveryExpiresAt        DateTime?                     @db.Timestamptz(3)
  lastErrorCode            String?                       @db.VarChar(64)
  processedAt              DateTime?                     @db.Timestamptz(3)
  createdAt                DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                      @updatedAt @db.Timestamptz(3)

  passwordResetToken PasswordResetToken? @relation(fields: [passwordResetTokenId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, createdAt])
  @@index([lockExpiresAt])
  @@index([processedAt])
}

model SecurityAuditEvent {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String?  @db.Uuid
  eventType        String
  ipAddress        String?  @db.VarChar(45)
  userAgentSummary String?  @db.VarChar(256)
  metadata         Json?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
}
