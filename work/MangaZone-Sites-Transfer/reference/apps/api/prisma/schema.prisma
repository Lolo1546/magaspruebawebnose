generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  PENDING_DELETION
  DELETED
}

enum PasswordResetRequestJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AssetStatus {
  PENDING
  READY
  QUARANTINED
  REJECTED
  DELETED
}

enum MangaType {
  MANGA
  MANHWA
  MANHUA
  WEBTOON
  NOVEL
  COMIC
  ONE_SHOT
  DOUJINSHI
  OEL
}

enum MangaDemography {
  SEINEN
  SHOUJO
  SHOUNEN
  JOSEI
  KODOMO
}

enum MangaEditorialStatus {
  DRAFT
  PUBLIC
  HIDDEN
}

enum EditorialAuditActionType {
  PROJECT_CREATED
  PROJECT_GROUP_ADDED
  PROJECT_GROUP_REMOVED
  MANGA_CREATED
  MANGA_UPDATED
  MANGA_PUBLISHED
  MANGA_HIDDEN
  RELEASE_PUBLISHED
  RELEASE_WITHDRAWN
  CHAPTER_THUMBNAIL_SET
  CHAPTER_THUMBNAIL_REQUESTED
  CHAPTER_THUMBNAIL_APPROVED
  CHAPTER_THUMBNAIL_REJECTED
  CHAPTER_THUMBNAIL_OVERRIDDEN
}

enum EditorialUploadPurpose {
  MANGA_PAGE
  MANGA_COVER
  CHAPTER_THUMBNAIL
}

enum ChapterThumbnailRequestStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum EditorialUploadState {
  PENDING
  FINALIZED
  REJECTED
  EXPIRED
}

enum MangaStatus {
  ONGOING
  COMPLETED
  PAUSED
  CANCELLED
  UNKNOWN
}

enum ContentRating {
  GENERAL
  TEEN
  MATURE
  ADULT
}

enum ContributionType {
  AUTHOR
  ARTIST
  STORY
  ILLUSTRATION
}

enum ChapterKind {
  REGULAR
  SPECIAL
  ONE_SHOT
  EXTRA
}

enum ChapterStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum ChapterReleaseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  HIDDEN
  WITHDRAWN
}

enum ChapterContributionType {
  TRANSLATOR
  CLEANER
  REDRAWER
  TYPESETTER
  PROOFREADER
  UPLOADER
  OTHER
}

enum LibraryStatus {
  READING
  PLAN_TO_READ
  ON_HOLD
  COMPLETED
  DROPPED
}

enum ListVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum ScanlationGroupStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
  CLOSED
}

enum ScanlationGroupMemberStatus {
  ACTIVE
  LEFT
  REMOVED
  SUSPENDED
}

enum ScanlationGroupRole {
  FOUNDER
  ADMIN
  UPLOADER
  TRANSLATOR
  CLEANER
  REDRAWER
  TYPESETTER
  PROOFREADER
}

enum ScanlationGroupRequestStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_INFO
}

enum CreationRequestActionType {
  INFO_REQUESTED
  RESUBMITTED
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ABANDONED
  COMPLETED
  AVAILABLE_FOR_CONTINUATION
  DISPUTED
}

enum ProjectGroupStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum ProjectRequestType {
  CREATE
  JOIN
  CONTINUE
  COLLABORATE
  TRANSFER
}

enum ProjectRequestStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_INFO
  CANCELLED
}

enum CommunityStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
  MERGED
}

enum CommunityRequestStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_INFO
}

enum CommunityMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum CommunityMemberStatus {
  ACTIVE
  LEFT
  REMOVED
  SUSPENDED
}

enum PostStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum PostCommentStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum MangaCommentStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  SEXUAL_CONTENT
  VIOLENCE
  SPOILER
  IMPERSONATION
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum ModerationActionType {
  HIDE_CONTENT
  RESTORE_CONTENT
  REMOVE_CONTENT
  WARN_USER
  RESTRICT_USER
  SUSPEND_USER
  BAN_USER
  UNBAN_USER
  APPROVE_REQUEST
  REJECT_REQUEST
  OTHER
}

enum AdministrativeAuditActionType {
  GLOBAL_ROLE_GRANTED
  GLOBAL_ROLE_REVOKED
  GLOBAL_PERMISSION_GRANTED
  GLOBAL_PERMISSION_REVOKED
  USER_SUSPENDED
  USER_RESTORED
}

enum ModerationTargetType {
  USER
  POST
  POST_COMMENT
  REVIEW
  COMMUNITY
  SCANLATION_GROUP
  PROJECT
  CHAPTER_RELEASE
  MANGA_COMMENT
}

enum ConversationType {
  DIRECT
  GROUP
}

enum UserSanctionType {
  WARNING
  RESTRICTION
  SUSPENSION
  BAN
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountDeletionRequestStatus {
  PENDING
  CANCELLED
  PROCESSING
  COMPLETED
  FAILED
}

enum ContentDeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationCategory {
  MANGA
  SOCIAL
  COMMUNITY
  GROUP
  MODERATION
  SYSTEM
}

model User {
  definedChapterThumbnails Chapter[] @relation("ChapterThumbnailActor")
  thumbnailRequests ChapterThumbnailRequest[] @relation("ThumbnailRequester")
  resolvedThumbnailRequests ChapterThumbnailRequest[] @relation("ThumbnailResolver")
  id                 String     @id @default(uuid(7)) @db.Uuid
  username           String?
  usernameNormalized String?    @unique
  email              String?
  emailNormalized    String?    @unique
  passwordHash       String?
  status             UserStatus
  emailVerifiedAt    DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  profile                          Profile?
  roles                            UserRole[]                   @relation("UserRoleSubject")
  roleAssignmentsMade              UserRole[]                   @relation("UserRoleAssigner")
  permissionGrants                 UserPermissionGrant[]        @relation("UserPermissionGrantSubject")
  permissionGrantsMade             UserPermissionGrant[]        @relation("UserPermissionGrantGranter")
  originatedAssets                 Asset[]                      @relation("AssetOwner")
  uploadedChapterReleases          ChapterRelease[]             @relation("ChapterReleaseUploader")
  libraryEntries                   LibraryEntry[]
  readingProgress                  ReadingProgress[]
  readingHistory                   ReadingHistoryEntry[]
  readingReleaseProgress           ReadingReleaseProgress[]
  lists                            UserList[]
  createdScanlationGroups          ScanlationGroup[]            @relation("ScanlationGroupCreator")
  scanlationMemberships            ScanlationGroupMember[]
  scanlationRequests               ScanlationGroupRequest[]     @relation("ScanlationGroupRequester")
  reviewedScanlationRequests       ScanlationGroupRequest[]     @relation("ScanlationGroupReviewer")
  scanlationRequestActions         ScanlationGroupRequestAction[] @relation("ScanlationGroupRequestActionActor")
  createdScanlationProjects        ScanlationProject[]          @relation("ScanlationProjectCreator")
  projectRequests                  ProjectRequest[]             @relation("ProjectRequestRequester")
  reviewedProjectRequests          ProjectRequest[]             @relation("ProjectRequestReviewer")
  chapterCredits                   ChapterCredit[]
  ownedCommunities                 Community[]                  @relation("CommunityOwner")
  communityMemberships             CommunityMember[]
  communityRequests                CommunityRequest[]           @relation("CommunityRequestRequester")
  reviewedCommunityRequests        CommunityRequest[]           @relation("CommunityRequestReviewer")
  communityRequestActions          CommunityRequestAction[]       @relation("CommunityRequestActionActor")
  communityPosts                   Post[]                       @relation("PostAuthor")
  postComments                     PostComment[]
  mangaComments                    MangaComment[]
  reviews                          Review[]
  reviewVotes                      ReviewVote[]
  submittedReports                 Report[]                     @relation("ReportReporter")
  reportsAboutUser                 Report[]                     @relation("ReportTargetUser")
  reviewedReports                  Report[]                     @relation("ReportReviewer")
  moderationActions                ModerationAction[]           @relation("ModerationActionModerator")
  sanctions                        UserSanction[]               @relation("UserSanctionSubject")
  sanctionsIssued                  UserSanction[]               @relation("UserSanctionIssuer")
  sanctionsRevoked                 UserSanction[]               @relation("UserSanctionRevoker")
  appeals                          Appeal[]                     @relation("AppealUser")
  reviewedAppeals                  Appeal[]                     @relation("AppealReviewer")
  accountDeletionRequests          AccountDeletionRequest[]
  contentDeletionRequests          ContentDeletionRequest[]     @relation("ContentDeletionRequester")
  reviewedDeletionRequests         ContentDeletionRequest[]     @relation("ContentDeletionReviewer")
  receivedNotifications            Notification[]               @relation("NotificationRecipient")
  actedNotifications               Notification[]               @relation("NotificationActor")
  createdConversations             Conversation[]               @relation("ConversationCreator")
  conversationMemberships          ConversationMember[]
  directConversationIdentitiesLow  DirectConversationIdentity[] @relation("DirectConversationUserLow")
  directConversationIdentitiesHigh DirectConversationIdentity[] @relation("DirectConversationUserHigh")
  sentMessages                     Message[]                    @relation("MessageSender")
  sessions                         Session[]
  emailVerificationTokens          EmailVerificationToken[]
  passwordResetTokens              PasswordResetToken[]
  securityAuditEvents              SecurityAuditEvent[]
  administrativeAuditEventsAsActor  AdministrativeAuditEvent[] @relation("AdministrativeAuditEventActor")
  administrativeAuditEventsAsTarget AdministrativeAuditEvent[] @relation("AdministrativeAuditEventTarget")
  editorialAuditEvents EditorialAuditEvent[]
  editorialUploadIntents EditorialUploadIntent[]

  @@index([status])
  @@index([createdAt])
}

model Profile {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @unique @db.Uuid
  displayName   String?
  bio           String?
  avatarAssetId String?  @db.Uuid
  bannerAssetId String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  user        User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  avatarAsset Asset? @relation("ProfileAvatarAsset", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  bannerAsset Asset? @relation("ProfileBannerAsset", fields: [bannerAssetId], references: [id], onDelete: SetNull)

  @@index([avatarAssetId])
  @@index([bannerAssetId])
}

model Asset {
  chapterThumbnails Chapter[] @relation("ChapterThumbnailAsset")
  thumbnailRequests ChapterThumbnailRequest[]
  thumbnailAuditBefore EditorialAuditEvent[] @relation("ThumbnailAuditBefore")
  thumbnailAuditAfter EditorialAuditEvent[] @relation("ThumbnailAuditAfter")
  id          String      @id @default(uuid(7)) @db.Uuid
  storageKey  String      @unique
  mimeType    String
  sizeBytes   BigInt      @db.BigInt
  width       Int?
  height      Int?
  status      AssetStatus
  ownerUserId String?     @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  sha256      String?     @db.VarChar(64)
  uploadIntent EditorialUploadIntent?

  owner              User?               @relation("AssetOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  profileAvatars     Profile[]           @relation("ProfileAvatarAsset")
  profileBanners     Profile[]           @relation("ProfileBannerAsset")
  mangaCovers        Manga[]             @relation("MangaCoverAsset")
  chapterPages       ChapterPage[]
  scanlationLogos    ScanlationGroup[]   @relation("ScanlationGroupLogo")
  scanlationBanners  ScanlationGroup[]   @relation("ScanlationGroupBanner")
  communityAvatars   Community[]         @relation("CommunityAvatarAsset")
  communityBanners   Community[]         @relation("CommunityBannerAsset")
  messageAttachments MessageAttachment[]

  @@index([status])
  @@index([ownerUserId])
  @@index([createdAt])
}

model Manga {
  id              String        @id @default(uuid(7)) @db.Uuid
  slug            String        @unique
  title           String
  normalizedTitle String        @default("")
  editorialStatus MangaEditorialStatus @default(DRAFT)
  version         Int           @default(1)
  originalTitle   String?
  type            MangaType
  demography      MangaDemography?
  status          MangaStatus
  description     String?
  coverAssetId    String?       @db.Uuid
  publicationYear Int?
  contentRating   ContentRating
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  coverAsset        Asset?                @relation("MangaCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  aliases           MangaAlias[]
  slugHistory       MangaSlugHistory[]
  genres            MangaGenre[]
  creators          MangaCreator[]
  chapters          Chapter[]
  libraryEntries    LibraryEntry[]
  readingProgress   ReadingProgress[]
  readingHistory    ReadingHistoryEntry[]
  listItems         UserListItem[]
  projects          ScanlationProject[]
  projectRequests   ProjectRequest[]
  communities       Community[]           @relation("CommunityRelatedManga")
  communityRequests CommunityRequest[]    @relation("CommunityRequestRelatedManga")
  reviews           Review[]
  comments          MangaComment[]
  notifications     Notification[]
  uploadIntents     EditorialUploadIntent[]
  editorialAuditEvents EditorialAuditEvent[]

  @@index([normalizedTitle])
  @@index([type])
  @@index([status])
  @@index([contentRating])
  @@index([createdAt])
  @@index([coverAssetId])
}

model MangaSlugHistory {
  id        String   @id @default(uuid(7)) @db.Uuid
  mangaId   String   @db.Uuid
  slug      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Restrict)

  @@index([mangaId])
}

model MangaAlias {
  id              String   @id @default(uuid(7)) @db.Uuid
  mangaId         String   @db.Uuid
  alias           String
  normalizedAlias String
  languageCode    String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([mangaId, normalizedAlias])
  @@index([normalizedAlias])
}

model Genre {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  mangas MangaGenre[]
}

model MangaGenre {
  mangaId String @db.Uuid
  genreId String @db.Uuid

  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([mangaId, genreId])
  @@index([genreId])
}

model Creator {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           String
  normalizedName String?
  biography      String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  mangas MangaCreator[]

  @@index([normalizedName])
}

model MangaCreator {
  mangaId          String           @db.Uuid
  creatorId        String           @db.Uuid
  contributionType ContributionType

  manga   Manga   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@id([mangaId, creatorId, contributionType])
  @@index([creatorId])
}

model Chapter {
  thumbnailAssetId String? @db.Uuid
  thumbnailActorUserId String? @db.Uuid
  thumbnailGroupId String? @db.Uuid
  thumbnailSetAt DateTime? @db.Timestamptz(3)
  thumbnailAsset Asset? @relation("ChapterThumbnailAsset", fields: [thumbnailAssetId], references: [id], onDelete: Restrict)
  thumbnailActor User? @relation("ChapterThumbnailActor", fields: [thumbnailActorUserId], references: [id], onDelete: Restrict)
  thumbnailGroup ScanlationGroup? @relation("ChapterThumbnailGroup", fields: [thumbnailGroupId], references: [id], onDelete: Restrict)
  thumbnailRequests ChapterThumbnailRequest[]
  thumbnailIntents EditorialUploadIntent[]
  thumbnailAuditEvents EditorialAuditEvent[]
  id           String        @id @default(uuid(7)) @db.Uuid
  mangaId      String        @db.Uuid
  kind         ChapterKind
  number       Decimal?      @db.Decimal(12, 4)
  displayLabel String
  sortOrder    Decimal       @db.Decimal(12, 4)
  title        String?
  status       ChapterStatus
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  manga            Manga                      @relation(fields: [mangaId], references: [id], onDelete: Restrict)
  releases         ChapterRelease[]
  readingProgress  ReadingProgress[]          @relation("ReadingProgressChapter")
  readingHistory   ReadingHistoryEntry[]      @relation("ReadingHistoryChapter")
  assignmentStarts ProjectAssignmentHistory[] @relation("ProjectAssignmentFromChapter")
  assignmentEnds   ProjectAssignmentHistory[] @relation("ProjectAssignmentToChapter")
  spoilerPosts     Post[]                     @relation("PostSpoilerChapter")
  spoilerReviews   Review[]                   @relation("ReviewSpoilerChapter")

  @@unique([mangaId, kind, number])
  @@unique([mangaId, kind, displayLabel])
  @@unique([mangaId, sortOrder])
  @@unique([mangaId, id])
  @@index([status])
}

model ChapterRelease {
  id               String               @id @default(uuid(7)) @db.Uuid
  chapterId        String               @db.Uuid
  projectId        String?              @db.Uuid
  language         String               @db.VarChar(35)
  status           ChapterReleaseStatus
  publishedAt      DateTime?            @db.Timestamptz(3)
  uploadedByUserId String?              @db.Uuid
  publishingGroupId String?             @db.Uuid
  supersedesReleaseId String?           @db.Uuid
  version          Int                 @default(1)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)

  chapter         Chapter               @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  project         ScanlationProject?    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  uploadedBy      User?                 @relation("ChapterReleaseUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  pages           ChapterPage[]
  groups          ChapterReleaseGroup[]
  credits         ChapterCredit[]
  readingProgress ReadingProgress[]     @relation("ReadingProgressRelease")
  readingHistory  ReadingHistoryEntry[] @relation("ReadingHistoryRelease")
  readingReleaseProgress ReadingReleaseProgress[]
  notifications   Notification[]
  publishingGroup ScanlationGroup? @relation("ReleaseResponsibleGroup", fields: [publishingGroupId], references: [id], onDelete: Restrict)
  supersedes ChapterRelease? @relation("ReleaseReplacement", fields: [supersedesReleaseId], references: [id], onDelete: Restrict)
  replacements ChapterRelease[] @relation("ReleaseReplacement")
  uploadIntents EditorialUploadIntent[]

  auditEvents EditorialAuditEvent[]

  @@index([publishingGroupId])
  @@index([supersedesReleaseId])
  @@index([chapterId, status, publishedAt])
  @@index([projectId, status, publishedAt])
  @@index([status, publishedAt])
  @@index([language])
  @@index([uploadedByUserId])
}

model ChapterReleaseGroup {
  chapterReleaseId String   @db.Uuid
  groupId          String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  chapterRelease ChapterRelease  @relation(fields: [chapterReleaseId], references: [id], onDelete: Cascade)
  group          ScanlationGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([chapterReleaseId, groupId])
  @@index([groupId])
}

model ChapterCredit {
  id                  String                  @id @default(uuid(7)) @db.Uuid
  chapterReleaseId    String                  @db.Uuid
  userId              String?                 @db.Uuid
  groupId             String?                 @db.Uuid
  contributionType    ChapterContributionType
  displayNameSnapshot String?
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)

  chapterRelease ChapterRelease   @relation(fields: [chapterReleaseId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  group          ScanlationGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([chapterReleaseId])
  @@index([userId])
  @@index([groupId])
}

model ChapterPage {
  id               String   @id @default(uuid(7)) @db.Uuid
  chapterReleaseId String   @db.Uuid
  pageNumber       Int
  assetId          String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  chapterRelease ChapterRelease @relation(fields: [chapterReleaseId], references: [id], onDelete: Cascade)
  asset          Asset          @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([chapterReleaseId, pageNumber])
  @@index([assetId])
}

model LibraryEntry {
  userId     String        @db.Uuid
  mangaId    String        @db.Uuid
  status     LibraryStatus
  isFavorite Boolean       @default(false)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Restrict)

  @@id([userId, mangaId])
  @@index([userId, status, updatedAt])
  @@index([userId, isFavorite, updatedAt])
}

model ReadingProgress {
  userId           String   @db.Uuid
  mangaId          String   @db.Uuid
  chapterId        String   @db.Uuid
  chapterReleaseId String?  @db.Uuid
  pageNumber       Int      @default(1)
  progressPercent  Int      @default(0)
  lastReadAt       DateTime @default(now()) @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga          Manga           @relation(fields: [mangaId], references: [id], onDelete: Restrict)
  chapter        Chapter         @relation("ReadingProgressChapter", fields: [mangaId, chapterId], references: [mangaId, id], onDelete: Restrict)
  chapterRelease ChapterRelease? @relation("ReadingProgressRelease", fields: [chapterReleaseId], references: [id], onDelete: SetNull)

  @@id([userId, mangaId])
  @@index([userId, lastReadAt])
  @@index([mangaId, chapterId])
  @@index([chapterReleaseId])
}

model ReadingReleaseProgress {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  chapterReleaseId String    @db.Uuid
  pageNumber       Int       @default(1)
  completedAt      DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterRelease ChapterRelease @relation(fields: [chapterReleaseId], references: [id], onDelete: Restrict)

  @@unique([userId, chapterReleaseId])
  @@index([chapterReleaseId])
}

model ReadingHistoryEntry {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  mangaId          String    @db.Uuid
  chapterId        String    @db.Uuid
  chapterReleaseId String?   @db.Uuid
  lastPageNumber   Int       @default(1)
  progressPercent  Int       @default(0)
  firstReadAt      DateTime  @default(now()) @db.Timestamptz(3)
  lastReadAt       DateTime  @default(now()) @db.Timestamptz(3)
  completedAt      DateTime? @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga          Manga           @relation(fields: [mangaId], references: [id], onDelete: Restrict)
  chapter        Chapter         @relation("ReadingHistoryChapter", fields: [mangaId, chapterId], references: [mangaId, id], onDelete: Restrict)
  chapterRelease ChapterRelease? @relation("ReadingHistoryRelease", fields: [chapterReleaseId], references: [id], onDelete: SetNull)

  @@unique([userId, chapterId])
  @@index([userId, lastReadAt])
  @@index([userId, mangaId, lastReadAt])
  @@index([mangaId, chapterId])
  @@index([chapterReleaseId])
}

model UserList {
  id          String         @id @default(uuid(7)) @db.Uuid
  userId      String         @db.Uuid
  name        String
  description String?
  visibility  ListVisibility @default(PRIVATE)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items UserListItem[]

  @@index([userId, updatedAt])
  @@index([visibility, updatedAt])
}

